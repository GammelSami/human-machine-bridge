[Unit]
Description=Immich Steam Screenshot Auto-Upload Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/sam/.config/immich-go/upload-steam.sh
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/home/sam/.config/immich-go/service-steam.log
StandardError=append:/home/sam/.config/immich-go/service-steam-error.log

[Install]
WantedBy=default.target
