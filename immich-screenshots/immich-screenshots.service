[Unit]
Description=Immich Screenshot Auto-Upload Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/sam/.config/immich-go/upload-screenshots.sh
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/home/sam/.config/immich-go/service.log
StandardError=append:/home/sam/.config/immich-go/service-error.log

[Install]
WantedBy=default.target
