#!/usr/bin/env python3
"""Send a global shortcut to every running TeamSpeak client."""

from pathlib import Path
import socket
import subprocess
import sys


action = sys.argv[1] if len(sys.argv) == 2 else None
if action not in {"mic", "sound", "afk"}:
    print("Usage: teamspeak-action mic|sound|afk", file=sys.stderr)
    sys.exit(2)


def listening(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.2):
            return True
    except OSError:
        return False


scripts = Path(__file__).parent
results = []
for port, name in ((5899, "teamspeak-hotkey"), (25639, "teamspeak3-hotkey")):
    if listening(port):
        results.append(subprocess.run([str(scripts / name), action], capture_output=True, text=True))

if results and not any(result.returncode == 0 for result in results):
    for result in results:
        if result.stderr:
            print(result.stderr.strip(), file=sys.stderr)
    sys.exit(1)
