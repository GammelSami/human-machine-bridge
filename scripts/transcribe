#!/usr/bin/env bash
# Transcribe audio or video files with Handy's selected model.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: transcribe <media-file> [language] [--output-file <path>]

Arguments:
  media-file     Path to an audio or video file
  language       Optional check only; Handy's CLI has no language option and uses
                 the language selected in the Handy app (warns on a mismatch)

Options:
  --output-file  Write the transcript to this file instead of stdout
  --help         Show this help message

Examples:
  transcribe voice.ogg
  transcribe video.mp4 --output-file /tmp/result.txt
EOF
}

if [[ $# -eq 0 || ${1:-} == --help ]]; then
    usage
    exit 0
fi

input=$1
shift
language=auto
output_file=

if [[ $# -gt 0 && $1 != --* ]]; then
    language=$1
    shift
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        --output-file)
            if [[ $# -lt 2 || -z $2 ]]; then
                echo 'transcribe: --output-file requires a path' >&2
                exit 2
            fi
            output_file=$2
            shift 2
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            echo "transcribe: unknown option: $1" >&2
            exit 2
            ;;
    esac
done

if [[ ! -f $input ]]; then
    echo "transcribe: file not found: $input" >&2
    exit 1
fi

if [[ $language != auto ]]; then
    settings=$HOME/.local/share/com.pais.handy/settings_store.json
    selected=$(python -c 'import json, sys; print(json.load(open(sys.argv[1]))["settings"]["selected_language"])' "$settings" 2>/dev/null || echo unknown)
    if [[ $language != "$selected" ]]; then
        echo "transcribe: Handy uses the language selected in its app ($selected), not '$language'; change it there if needed" >&2
    fi
fi

temp_wav=$(mktemp --suffix=.wav)
temp_json=$(mktemp)
temp_text=$(mktemp)
trap 'rm -f "$temp_wav" "$temp_json" "$temp_text"' EXIT

extract_text() {
    python -c 'import json, sys; print(json.load(sys.stdin)["text"])' < "$temp_json" > "$temp_text" 2>/dev/null
}

ffmpeg -nostdin -loglevel error -i "$input" -vn -ar 16000 -ac 1 -c:a pcm_s16le -y "$temp_wav"
handy --transcribe-file "$temp_wav" --json > "$temp_json" || true

# The GPU run fails without JSON output when VRAM is short (e.g. while a local
# LLM occupies it); retry on the CPU, which is slower but always has memory.
if ! extract_text; then
    # --list-devices aborts after printing the list, so ignore its exit status.
    cpu_index=$(handy --list-devices 2>/dev/null | sed -n 's/.*index=\([0-9]\+\) kind=cpu.*/\1/p' | head -n 1 || true)
    if [[ -z $cpu_index ]]; then
        echo 'transcribe: transcription failed and no CPU device was found for a retry' >&2
        exit 1
    fi
    echo 'transcribe: GPU transcription failed (VRAM full?); retrying on the CPU' >&2
    handy --transcribe-file "$temp_wav" --json --device-index "$cpu_index" > "$temp_json" || true
    if ! extract_text; then
        echo 'transcribe: transcription failed on the CPU as well' >&2
        exit 1
    fi
fi

if [[ -n $output_file ]]; then
    cp "$temp_text" "$output_file"
else
    cat "$temp_text"
fi
